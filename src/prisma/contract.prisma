
// use prisma-8

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  username     String?
  name         String?
  passwordHash String?
  role         String    @default("SALES_REP")
  isActive     Boolean   @default(true)
  tasks        Task[]
  leads        Lead[]
  contacts     Contact[]
  companies    Company[]
  deals        Deal[]
  calendarEvents CalendarEvent[]
  automations     Automation[]
  automationRuns  AutomationRun[]
  notifications Notification[]
  createdAt    DateTime  @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt
}
model Company {
  id          Int       @id @default(autoincrement())
  name        String
  website     String?
  industry    String?
  phone       String?
  email       String?
  address     String?
  description String?
  userId Int
user   User @relation(fields: [userId], references: [id])
  contacts    Contact[]
  leads       Lead[]
  deals       Deal[]
  calendarEvents CalendarEvent[]
  createdAt   DateTime  @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}


model Contact {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String?
  email     String?   @unique
  phone     String?
  jobTitle  String?
  userId Int
user   User @relation(fields: [userId], references: [id])
  companyId Int?
  company   Company?  @relation(fields: [companyId], references: [id])
  createdAt DateTime  @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
  tasks        Task[]
  calendarEvents CalendarEvent[]
}

model Lead {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  source    String?
  status    String   @default("NEW")
  score     Int?
  value     Float    @default(0)
  owner     String   @default("Unassigned")
  userId Int
user   User @relation(fields: [userId], references: [id])
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
  tasks        Task[]
  calendarEvents CalendarEvent[]
}

model Deal {
  id        Int      @id @default(autoincrement())
  title     String
  stage     String   @default("discovery")
  value     Float    @default(0)
  owner     String   @default("Unassigned")
  closeDate DateTime
  tasks        Task[]
  calendarEvents CalendarEvent[]
 userId Int
user   User @relation(fields: [userId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  type        String   @default("Follow-up")
  priority    String   @default("Medium")
  due         DateTime
  done        Boolean  @default(false)

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  leadId      Int?
  lead        Lead?    @relation(fields: [leadId], references: [id])

  contactId   Int?
  contact     Contact? @relation(fields: [contactId], references: [id])

  dealId      Int?
  deal        Deal?    @relation(fields: [dealId], references: [id])

  createdAt   DateTime @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}

model Automation {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  triggerType String
  conditions  String?
  actionType  String
  actionConfig String?
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  runs        AutomationRun[]

  createdAt   DateTime @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}

model AutomationRun {
  id           Int      @id @default(autoincrement())
  status       String   @default("PENDING")
  triggerData  String?
  result       String?
  error        String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  automationId Int
  automation   Automation @relation(fields: [automationId], references: [id])

  userId       Int
  user         User     @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt
}

model CalendarEvent {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  location    String?
  type        String   @default("MEETING")
  status      String   @default("SCHEDULED")

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  leadId      Int?
  lead        Lead?    @relation(fields: [leadId], references: [id])

  contactId   Int?
  contact     Contact? @relation(fields: [contactId], references: [id])

  companyId   Int?
  company     Company? @relation(fields: [companyId], references: [id])

  dealId      Int?
  deal        Deal?    @relation(fields: [dealId], references: [id])

  createdAt   DateTime @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  href      String?
  dedupeKey String?  @unique

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @onCreate(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}
